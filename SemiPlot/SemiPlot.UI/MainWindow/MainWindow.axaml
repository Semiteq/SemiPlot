<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SemiPlot.UI.MainWindow"
        xmlns:chart="clr-namespace:SemiPlot.UI.Chart"
        xmlns:navigation="clr-namespace:SemiPlot.UI.Navigation"
        xmlns:legend="clr-namespace:SemiPlot.UI.Legend"
        xmlns:minimap="clr-namespace:SemiPlot.UI.Minimap"
        xmlns:messages="clr-namespace:SemiPlot.UI.Messages"
        xmlns:text="clr-namespace:SemiPlot.UI.Localization"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="800"
        x:Class="SemiPlot.UI.MainWindow.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{x:Static text:Resources.WindowTitle}"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

        <local:AppMenuBar Grid.Row="0"
                          Name="MenuBar" />

        <Border Grid.Row="1"
                Name="NavigationBar"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="8,4"
                IsVisible="{Binding IsNavigationBarVisible}">
            <navigation:NavigationBarView DataContext="{Binding NavigationBarViewModel}" />
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto">

            <Border Grid.Column="0"
                    Name="ChartContent"
                    Background="{DynamicResource AppContentBackgroundBrush}">
                <chart:TrendChartView DataContext="{Binding ChartViewModel}" />
            </Border>

            <Border Grid.Column="1"
                    Name="LegendPanel"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    Width="{Binding LegendViewModel.RequestedWidth,
                                    FallbackValue={x:Static legend:TrendLegendViewModel.ExpandedWidth}}"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Padding="4"
                    IsVisible="{Binding IsLegendVisible}">
                <legend:TrendLegendView DataContext="{Binding LegendViewModel}" />
            </Border>

        </Grid>

        <Border Grid.Row="3"
                Name="MinimapRow"
                IsVisible="{Binding IsMinimapVisible}">
            <minimap:MinimapView Name="Minimap"
                                 Height="36"
                                 DataContext="{Binding MinimapViewModel}" />
        </Border>

        <Border Grid.Row="4"
                Name="MessagePanel"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="8,4"
                IsVisible="{Binding MessagePanel.IsVisible}">
            <messages:MessagePanelView DataContext="{Binding MessagePanel}" />
        </Border>

        <Border Grid.Row="5"
                Name="StatusBar"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="8,4"
                IsVisible="{Binding !HasStartupFailure}">
            <local:AppStatusBar DataContext="{Binding StatusBar}" />
        </Border>

        <Border Grid.Row="6"
                Name="StartupFailurePanel"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="8,4"
                IsVisible="{Binding HasStartupFailure}">
            <StackPanel>
                <TextBlock Name="StartupFailureTitle"
                           Text="{Binding StartupFailure.Title}"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />
                <TextBlock Name="StartupFailureDetail"
                           Text="{Binding StartupFailure.Detail}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
                <TextBlock Name="StartupFailureRemedy"
                           Text="{Binding StartupFailure.Remedy}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

    </Grid>

</Window>
