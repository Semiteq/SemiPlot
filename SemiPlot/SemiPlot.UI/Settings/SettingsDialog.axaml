<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SemiPlot.UI.Settings"
        xmlns:text="clr-namespace:SemiPlot.UI.Localization"
        mc:Ignorable="d"
        d:DesignHeight="560"
        x:Class="SemiPlot.UI.Settings.SettingsDialog"
        x:DataType="local:SettingsViewModel"
        Title="{x:Static text:Resources.SettingsTitle}"
        Width="528"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataTemplate x:Key="SettingsChoiceTemplate"
                      x:DataType="local:SettingsChoice">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20"
          RowDefinitions="Auto,Auto"
          RowSpacing="20">

        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="14"
              RowSpacing="10">

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="{x:Static text:Resources.SettingsInterfaceHeader}"
                       FontWeight="Bold" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.SettingsLanguageLabel}" />

            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      Name="SettingsLanguage"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      ItemTemplate="{StaticResource SettingsChoiceTemplate}" />

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.SettingsThemeLabel}" />

            <ComboBox Grid.Row="2"
                      Grid.Column="1"
                      Name="SettingsTheme"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme}"
                      ItemTemplate="{StaticResource SettingsChoiceTemplate}" />

            <TextBlock Grid.Row="3"
                       Grid.ColumnSpan="2"
                       Margin="0,10,0,0"
                       Text="{x:Static text:Resources.SettingsConnectionHeader}"
                       FontWeight="Bold" />

            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.SettingsHostLabel}" />

            <TextBox Grid.Row="4"
                     Grid.Column="1"
                     Name="SettingsHost"
                     Classes.invalid="{Binding !IsHostValid}"
                     Text="{Binding Host}" />

            <TextBlock Grid.Row="5"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.SettingsPortLabel}" />

            <NumericUpDown Grid.Row="5"
                           Grid.Column="1"
                           Name="SettingsPort"
                           HorizontalAlignment="Stretch"
                           Classes.invalid="{Binding !IsPortValid}"
                           Minimum="{x:Static local:SettingsViewModel.LowestPort}"
                           Maximum="{x:Static local:SettingsViewModel.HighestPort}"
                           Increment="1"
                           FormatString="0"
                           ParsingNumberStyle="Integer"
                           Value="{Binding Port}" />

            <TextBlock Grid.Row="6"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.SettingsDatabaseLabel}" />

            <TextBox Grid.Row="6"
                     Grid.Column="1"
                     Name="SettingsDatabase"
                     Classes.invalid="{Binding !IsDatabaseValid}"
                     Text="{Binding Database}" />

            <TextBlock Grid.Row="7"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.SettingsUserLabel}" />

            <TextBox Grid.Row="7"
                     Grid.Column="1"
                     Name="SettingsUser"
                     Classes.invalid="{Binding !IsUserValid}"
                     Text="{Binding User}" />

            <TextBlock Grid.Row="8"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.SettingsPasswordLabel}" />

            <TextBox Grid.Row="8"
                     Grid.Column="1"
                     Name="SettingsPassword"
                     PasswordChar="*"
                     Classes.invalid="{Binding !IsPasswordValid}"
                     Text="{Binding Password}" />

            <TextBlock Grid.Row="9"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.SettingsPollIntervalLabel}" />

            <NumericUpDown Grid.Row="9"
                           Grid.Column="1"
                           Name="SettingsPollInterval"
                           HorizontalAlignment="Stretch"
                           Classes.invalid="{Binding !IsPollIntervalValid}"
                           Minimum="{x:Static local:SettingsViewModel.LowestPollInterval}"
                           Maximum="{x:Static local:SettingsViewModel.HighestPollInterval}"
                           Increment="1"
                           FormatString="0"
                           ParsingNumberStyle="Integer"
                           Value="{Binding PollInterval}" />

        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">

            <Panel Grid.Column="0">

                <TextBlock Name="SettingsValidationMessage"
                           Classes="form-message error"
                           Text="{Binding ValidationMessage}" />

                <TextBlock Name="SettingsRestartNotice"
                           Classes="form-message"
                           Text="{x:Static text:Resources.SettingsRestartNotice}">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsRestartPending" />
                            <Binding Path="ValidationMessage"
                                     Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

            </Panel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Spacing="8">

                <Button Name="SettingsSaveButton"
                        Content="{x:Static text:Resources.SettingsSave}"
                        Command="{Binding SaveCommand}"
                        Padding="12,2" />

                <Button Name="SettingsClose"
                        Content="{x:Static text:Resources.SettingsClose}"
                        Click="OnCloseClick"
                        Padding="12,2" />

            </StackPanel>

        </Grid>

    </Grid>

</Window>
