<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SemiPlot.UI.PenEditor"
        xmlns:legend="clr-namespace:SemiPlot.UI.Legend"
        xmlns:tables="clr-namespace:SemiPlot.UI.Tables"
        xmlns:text="clr-namespace:SemiPlot.UI.Localization"
        xmlns:trends="clr-namespace:SemiPlot.Core.Trends;assembly=SemiPlot.Core"
        x:Class="SemiPlot.UI.PenEditor.PenEditorWindow"
        x:DataType="local:PenEditorViewModel"
        Title="{x:Static text:Resources.PenEditorTitle}"
        Width="{x:Static local:PenEditorWindow.DesignedWidth}"
        MinWidth="{x:Static local:PenEditorWindow.MinimumWidth}"
        Height="{x:Static local:PenEditorWindow.DesignedHeight}"
        MinHeight="{x:Static local:PenEditorWindow.MinimumHeight}"
        SizeToContent="Manual"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataGridLength x:Key="PenListIdColumnWidth">84</DataGridLength>
        <x:Double x:Key="DataGridCellMinHeight">28</x:Double>
        <ColumnDefinitions x:Key="PenFormColumns"
                           x:Shared="False">
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="240" />
        </ColumnDefinitions>
        <DataTemplate x:Key="LineStyleItem"
                      x:DataType="trends:PenLineStyle">
            <TextBlock Text="{Binding Converter={x:Static local:PenLineStyleConverters.ToLabel}}" />
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button#GroupActionsButton">
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryForegroundBrush}" />
        </Style>
        <Style Selector="Button#GroupActionsButton:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.grid-cell">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Grid.form-grid">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="RowSpacing" Value="8" />
        </Style>
        <Style Selector="TextBlock.form-label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.form-title">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.form-section">
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.pane-line">
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Styles>

    <Grid Margin="16"
          RowDefinitions="Auto,*"
          RowSpacing="16">

        <Grid Grid.Row="0"
              Name="PenEditorTopBar"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8">

            <TextBox Grid.Column="0"
                     Name="PenListFilter"
                     Width="{x:Static local:PenEditorWindow.FilterBoxWidth}"
                     HorizontalAlignment="Left"
                     PlaceholderText="{x:Static text:Resources.PenEditorFilterPlaceholder}"
                     Text="{Binding FilterText}" />

            <TextBlock Grid.Column="1"
                       Name="PenEditorAddedCount"
                       VerticalAlignment="Center"
                       Text="{Binding AddedCountText}" />

            <Button Grid.Column="2"
                    Name="PenEditorRefreshButton"
                    Content="{x:Static text:Resources.PenEditorRefresh}"
                    Command="{Binding RefreshCommand}" />

        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,16,Auto,16,Auto">

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4">

                <DataGrid Name="PenList"
                          ItemsSource="{Binding PenRows}"
                          SelectedItem="{Binding SelectedRow, Mode=OneWay}"
                          SelectionChanged="OnPenListSelectionChanged"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="False"
                          RowHeight="{x:Static local:PenEditorWindow.RowHeight}"
                          tables:HeaderMeasuredColumns.FitsColumns="True">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="{x:Static text:Resources.PenEditorColumnId}"
                                                Width="{StaticResource PenListIdColumnWidth}"
                                                CanUserSort="True"
                                                CustomSortComparer="{x:Static local:PenRowOrder.ById}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:PenRowViewModel">
                                    <TextBlock Name="RowId"
                                               Classes="grid-cell"
                                               Margin="12,0,8,0"
                                               Text="{Binding Pen.Id}"
                                               ToolTip.Tip="{Binding $self.Text}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{x:Static text:Resources.PenEditorColumnName}"
                                                Width="200"
                                                CanUserSort="True"
                                                CustomSortComparer="{x:Static local:PenRowOrder.ByName}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:PenRowViewModel">
                                    <Grid Margin="12,0,8,0"
                                          ColumnDefinitions="Auto,*"
                                          ColumnSpacing="8">

                                        <Border Grid.Column="0"
                                                Name="RowColor"
                                                Width="12"
                                                Height="12"
                                                CornerRadius="6"
                                                VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1">
                                            <Border.Background>
                                                <Binding Path="Pen.Color"
                                                         Converter="{x:Static legend:LegendConverters.HexToBrush}" />
                                            </Border.Background>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Name="RowName"
                                                   Classes="grid-cell"
                                                   Text="{Binding Pen.Name}"
                                                   ToolTip.Tip="{Binding $self.Text}" />

                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{x:Static text:Resources.PenEditorColumnUnit}"
                                                Width="96"
                                                CanUserSort="True"
                                                CustomSortComparer="{x:Static local:PenRowOrder.ByUnit}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:PenRowViewModel">
                                    <TextBlock Name="RowUnit"
                                               Classes="grid-cell"
                                               Margin="12,0,8,0"
                                               Text="{Binding Pen.Unit}"
                                               ToolTip.Tip="{Binding $self.Text}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{x:Static text:Resources.PenEditorColumnOnStart}"
                                                Width="120"
                                                CanUserSort="True"
                                                CustomSortComparer="{x:Static local:PenRowOrder.ByEnabledOnStart}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:PenRowViewModel">
                                    <PathIcon Name="RowEnabledOnStart"
                                              Width="12"
                                              Height="12"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="{StaticResource CheckGeometry}"
                                              IsVisible="{Binding Pen.EnabledOnStart}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{x:Static text:Resources.PenEditorColumnGroups}"
                                                Width="96"
                                                CanUserSort="True"
                                                CustomSortComparer="{x:Static local:PenRowOrder.ByGroups}"
                                                tables:HeaderMeasuredColumns.IsFill="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:PenRowViewModel">
                                    <TextBlock Name="RowGroups"
                                               Classes="grid-cell"
                                               Margin="12,0,12,0"
                                               Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                               Text="{Binding GroupsText}"
                                               ToolTip.Tip="{Binding $self.Text}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

            </Border>

            <Border Grid.Column="2"
                    Name="PenFormPanel"
                    Width="{x:Static local:PenEditorWindow.PenPaneWidth}"
                    Padding="16"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsEnabled="{Binding !IsRefreshing}">

                <Panel>

                    <TextBlock Name="PenFormEmptyHint"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                               Text="{x:Static text:Resources.PenFormEmptyHint}"
                               IsVisible="{Binding SelectedForm, Converter={x:Static ObjectConverters.IsNull}}" />

                    <ScrollViewer Name="PenFormScroller"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding SelectedForm, Converter={x:Static ObjectConverters.IsNotNull}}">

                        <Panel Name="PenForm"
                               Classes="invalid-glyph"
                               DataContext="{Binding SelectedForm}">

                            <StackPanel x:DataType="local:PenFormViewModel">

                                <Grid Height="24"
                                      ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">

                                    <TextBlock Grid.Column="0"
                                               Name="PenFormTitleId"
                                               Classes="form-title"
                                               Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                               Text="{Binding Row.Pen.Id}" />

                                    <TextBlock Grid.Column="1"
                                               Name="PenFormTitleName"
                                               Classes="form-title"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Row.Pen.Name}"
                                               ToolTip.Tip="{Binding $self.Text}" />

                                </Grid>

                                <TextBlock Classes="form-section"
                                           Text="{x:Static text:Resources.PenFormSectionLabel}" />

                                <Grid Classes="form-grid"
                                      ColumnDefinitions="{StaticResource PenFormColumns}"
                                      RowDefinitions="32,32,32,32">

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Classes="form-label"
                                               Text="{x:Static text:Resources.PenEditorColumnName}" />

                                    <TextBox Grid.Row="0"
                                             Grid.Column="1"
                                             Name="FormName"
                                             local:PenEditorWindow.Field="Name"
                                             Classes.invalid="{Binding !IsNameValid}"
                                             Text="{Binding Name}" />

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Classes="form-label"
                                               Text="{x:Static text:Resources.PenEditorColumnUnit}" />

                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Name="FormUnit"
                                             Width="120"
                                             HorizontalAlignment="Left"
                                             local:PenEditorWindow.Field="Unit"
                                             Classes.invalid="{Binding !IsUnitValid}"
                                             Text="{Binding Unit}" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Classes="form-label"
                                               Text="{x:Static text:Resources.PenFormMaskLabel}" />

                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             Name="FormMask"
                                             Width="120"
                                             HorizontalAlignment="Left"
                                             local:PenEditorWindow.Field="Mask"
                                             Classes.invalid="{Binding !IsMaskValid}"
                                             Text="{Binding Mask}" />

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               Classes="form-label"
                                               Text="{x:Static text:Resources.PenFormMaskPreviewLabel}" />

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Name="FormMaskPreview"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                               Text="{Binding MaskPreview}"
                                               ToolTip.Tip="{Binding $self.Text}" />

                                </Grid>

                                <TextBlock Classes="form-section"
                                           Text="{x:Static text:Resources.PenFormSectionAppearance}" />

                                <Grid Classes="form-grid"
                                      ColumnDefinitions="{StaticResource PenFormColumns}"
                                      RowDefinitions="32,32">

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Classes="form-label"
                                               Text="{x:Static text:Resources.PenFormColorLabel}" />

                                    <ColorPicker Grid.Row="0"
                                                 Grid.Column="1"
                                                 Name="FormColorPicker"
                                                 Height="32"
                                                 HorizontalAlignment="Stretch"
                                                 IsAlphaEnabled="False"
                                                 IsAlphaVisible="False">
                                        <ColorPicker.Color>
                                            <Binding Path="Color"
                                                     Mode="OneWay"
                                                     Converter="{x:Static local:PenColorConverters.ToColor}" />
                                        </ColorPicker.Color>
                                        <ColorPicker.Content>
                                            <Border Name="FormColorSwatch"
                                                    Margin="4"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    CornerRadius="{StaticResource ColorPickerCornerRadius}"
                                                    Background="{Binding Color, Converter={x:Static local:PenColorConverters.ToBrush}}" />
                                        </ColorPicker.Content>
                                    </ColorPicker>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Classes="form-label"
                                               Text="{x:Static text:Resources.PenFormLineStyleLabel}" />

                                    <ComboBox Grid.Row="1"
                                              Grid.Column="1"
                                              Name="FormLineStyle"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Static local:PenEditorWindow.LineStyles}"
                                              SelectedItem="{Binding LineStyle, Mode=OneWay}"
                                              ItemTemplate="{StaticResource LineStyleItem}"
                                              SelectionChanged="OnLineStyleSelectionChanged" />

                                </Grid>

                                <TextBlock Classes="form-section"
                                           Text="{x:Static text:Resources.PenFormSectionOnStart}" />

                                <Grid Classes="form-grid"
                                      ColumnDefinitions="{StaticResource PenFormColumns}"
                                      RowDefinitions="32,Auto,32">

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Classes="form-label"
                                               Text="{x:Static text:Resources.PenFormVisibilityLabel}" />

                                    <CheckBox Grid.Row="0"
                                              Grid.Column="1"
                                              Name="FormEnabledOnStart"
                                              HorizontalAlignment="Left"
                                              Content="{x:Static text:Resources.PenFormShowOnChart}"
                                              IsChecked="{Binding EnabledOnStart, Mode=OneWay}"
                                              IsCheckedChanged="OnStartFlagChanged" />

                                    <Grid Grid.Row="1"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          Name="FormScale"
                                          Classes="form-grid"
                                          ColumnDefinitions="{StaticResource PenFormColumns}"
                                          RowDefinitions="32,32">

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Classes="form-label"
                                                   Text="{x:Static text:Resources.AxisScaleMinimumLabel}" />

                                        <TextBox Grid.Row="0"
                                                 Grid.Column="1"
                                                 Name="FormScaleMinOnStart"
                                                 Width="120"
                                                 HorizontalAlignment="Left"
                                                 Classes.invalid="{Binding !IsScaleMinOnStartValid}"
                                                 Text="{Binding ScaleMinOnStart}" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Classes="form-label"
                                                   Text="{x:Static text:Resources.AxisScaleMaximumLabel}" />

                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Name="FormScaleMaxOnStart"
                                                 Width="120"
                                                 HorizontalAlignment="Left"
                                                 Classes.invalid="{Binding !IsScaleMaxOnStartValid}"
                                                 Text="{Binding ScaleMaxOnStart}" />

                                    </Grid>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Classes="form-label"
                                               Text="{x:Static text:Resources.PenFormScaleTypeLabel}" />

                                    <CheckBox Grid.Row="2"
                                              Grid.Column="1"
                                              Name="FormLogScaleOnStart"
                                              HorizontalAlignment="Left"
                                              Content="{x:Static text:Resources.PenFormLogarithmic}"
                                              IsChecked="{Binding LogScaleOnStart, Mode=OneWay}"
                                              IsCheckedChanged="OnStartFlagChanged" />

                                </Grid>

                                <TextBlock Name="FormMessage"
                                           Margin="0,16,0,0"
                                           Classes="form-message error"
                                           Text="{Binding Message}" />

                            </StackPanel>

                        </Panel>

                    </ScrollViewer>

                </Panel>

            </Border>

            <Border Grid.Column="4"
                    Name="GroupsPanel"
                    Width="{x:Static local:PenEditorWindow.GroupsPaneWidth}"
                    Padding="16"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsEnabled="{Binding !IsRefreshing}">

                <Panel DataContext="{Binding Groups}">

                    <Grid x:DataType="local:PenGroupsViewModel"
                          RowDefinitions="Auto,Auto,*,Auto,Auto"
                          RowSpacing="8">

                        <StackPanel Grid.Row="0"
                                    Spacing="4">

                            <TextBlock Name="GroupsTitle"
                                       Classes="form-title"
                                       Height="24"
                                       Text="{x:Static text:Resources.PenGroupsTitle}" />

                            <TextBlock Name="GroupsSubtitle"
                                       Classes="pane-line"
                                       Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                       Text="{x:Static text:Resources.PenGroupsSubtitle}" />

                        </StackPanel>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">

                            <TextBox Grid.Column="0"
                                     Name="NewGroupName"
                                     PlaceholderText="{x:Static text:Resources.PenGroupsNewNamePlaceholder}"
                                     Text="{Binding NewGroupName}" />

                            <Button Grid.Column="1"
                                    Name="CreateGroupButton"
                                    Content="{x:Static text:Resources.PenGroupsCreate}"
                                    Command="{Binding CreateGroupCommand}" />

                        </Grid>

                        <Border Grid.Row="2"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4">

                            <DataGrid Name="GroupList"
                                      ItemsSource="{Binding Groups}"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      CanUserSortColumns="False"
                                      CanUserResizeColumns="True"
                                      CanUserReorderColumns="False"
                                      RowHeight="{x:Static local:PenEditorWindow.RowHeight}"
                                      tables:HeaderMeasuredColumns.FitsColumns="True">
                                <DataGrid.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Light">
                                                <StaticResource x:Key="DataGridRowSelectedBackground"
                                                                ResourceKey="DataGridRowBackground" />
                                                <StaticResource x:Key="DataGridRowSelectedPointeroverBackground"
                                                                ResourceKey="DataGridRowPointeroverBackground" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Dark">
                                                <StaticResource x:Key="DataGridRowSelectedBackground"
                                                                ResourceKey="DataGridRowBackground" />
                                                <StaticResource x:Key="DataGridRowSelectedPointeroverBackground"
                                                                ResourceKey="DataGridRowPointeroverBackground" />
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </DataGrid.Resources>
                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Width="36"
                                                            CanUserSort="False"
                                                            CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="local:PenGroupViewModel">
                                                <CheckBox Name="MembershipBox"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding Membership.IsMember, Mode=OneWay, FallbackValue=False}"
                                                          Command="{Binding Membership.ToggleMembershipCommand}"
                                                          IsEnabled="{Binding Membership, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="{x:Static text:Resources.PenGroupsColumnGroup}"
                                                            Width="120"
                                                            CanUserSort="False"
                                                            tables:HeaderMeasuredColumns.IsFill="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="local:PenGroupViewModel">
                                                <Grid Margin="12,0,8,0"
                                                      ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="8">

                                                    <TextBlock Grid.Column="0"
                                                               Name="GroupName"
                                                               Classes="grid-cell"
                                                               Text="{Binding Group.Name}"
                                                               ToolTip.Tip="{Binding $self.Text}" />

                                                    <TextBlock Grid.Column="1"
                                                               Name="GroupMemberCount"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                                               Text="{Binding MemberCount}"
                                                               ToolTip.Tip="{x:Static text:Resources.PenGroupsMemberCountTip}" />

                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="{x:Static text:Resources.PenGroupsColumnActions}"
                                                            Width="40"
                                                            CanUserSort="False"
                                                            CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="local:PenGroupViewModel">
                                                <Button Name="GroupActionsButton"
                                                        Theme="{StaticResource InnerIconButton}"
                                                        Content="{StaticResource MoreGeometry}"
                                                        Margin="12,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="{x:Static text:Resources.PenGroupsActionsTip}">
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">

                                                            <MenuItem Name="GroupRenameItem"
                                                                      Header="{x:Static text:Resources.PenGroupsRename}"
                                                                      Command="{Binding AskRenameCommand}" />

                                                            <MenuItem Name="GroupFoldItem"
                                                                      Header="{x:Static text:Resources.PenGroupsFoldedOnStartLabel}"
                                                                      ToggleType="CheckBox"
                                                                      IsChecked="{Binding FoldedOnStart, Mode=OneWay}"
                                                                      Command="{Binding ToggleFoldedOnStartCommand}" />

                                                            <Separator />

                                                            <MenuItem Name="GroupDeleteItem"
                                                                      Header="{x:Static text:Resources.PenGroupsDelete}"
                                                                      Command="{Binding AskDeleteCommand}" />

                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                        </Border>

                        <Panel Grid.Row="3"
                               Name="GroupActionBlock"
                               Height="116">

                            <StackPanel Name="GroupRenameBlock"
                                        Spacing="8">
                                <StackPanel.IsVisible>
                                    <Binding Path="PendingRename"
                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                </StackPanel.IsVisible>

                                <TextBlock Classes="form-label"
                                           Height="20"
                                           Text="{x:Static text:Resources.PenGroupsNameLabel}" />

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">

                                    <Panel Grid.Column="0"
                                           DataContext="{Binding PendingRename}">

                                        <TextBox x:DataType="local:PenGroupViewModel"
                                                 Name="GroupRename"
                                                 Classes.invalid="{Binding !IsNameValid}"
                                                 Text="{Binding RenameDraft}" />

                                    </Panel>

                                    <Button Grid.Column="1"
                                            Name="GroupRenameDoneButton"
                                            Content="{x:Static text:Resources.PenGroupsRenameDone}"
                                            Command="{Binding CloseRenameCommand}" />

                                </Grid>

                            </StackPanel>

                            <StackPanel Name="GroupDeletionBlock"
                                        Spacing="8">
                                <StackPanel.IsVisible>
                                    <Binding Path="PendingDeletion"
                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                </StackPanel.IsVisible>

                                <TextBlock Name="GroupDeletionQuestion"
                                           Classes="pane-line"
                                           Text="{Binding PendingDeletion.Question}"
                                           ToolTip.Tip="{Binding $self.Text}" />

                                <TextBlock Name="GroupDeletionCount"
                                           Classes="pane-line"
                                           Text="{Binding PendingDeletion.Count}" />

                                <TextBlock Name="GroupDeletionNote"
                                           Classes="pane-line"
                                           Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                           Text="{x:Static text:Resources.PenGroupsDeleteKeepsPens}" />

                                <StackPanel HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="8">

                                    <Button Name="ConfirmDeleteButton"
                                            Classes="destructive"
                                            Content="{x:Static text:Resources.PenGroupsDelete}"
                                            Command="{Binding ConfirmDeleteCommand}" />

                                    <Button Name="CancelDeleteButton"
                                            Content="{x:Static text:Resources.PenGroupsCancel}"
                                            Command="{Binding CancelDeleteCommand}" />

                                </StackPanel>

                            </StackPanel>

                        </Panel>

                        <TextBlock Grid.Row="4"
                                   Name="GroupsMessage"
                                   Classes="form-message error"
                                   Text="{Binding Message}" />

                    </Grid>

                </Panel>

            </Border>

        </Grid>

    </Grid>

</Window>
