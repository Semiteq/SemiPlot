#!/usr/bin/env bash
# Install once: git config core.hooksPath .githooks
set -euo pipefail

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [[ "$branch" == "master" || "$branch" == "main" ]]; then
  echo "pre-commit: direct commit to '$branch' is forbidden; branch first:" >&2
  echo "  git switch -c <feature-name> origin/master" >&2
  exit 1
fi

cd "$(git rev-parse --show-toplevel)"

mapfile -d '' staged < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.cs')
if [[ "${#staged[@]}" -eq 0 ]]; then
  exit 0
fi

command -v dotnet >/dev/null || { echo "pre-commit: dotnet SDK required" >&2; exit 1; }
dotnet tool restore >/dev/null
status=0
for file in "${staged[@]}"; do
  git show ":$file" | dotnet terse --stdin "$file" || status=1
done
if [[ "$status" -ne 0 ]]; then
  echo "pre-commit: terse reported findings or failed to run; see above" >&2
  exit 1
fi

if dotnet format SemiPlot.slnx --verify-no-changes --no-restore --verbosity quiet \
  --include "${staged[@]}"; then
  exit 0
fi
echo "pre-commit: formatting differs; run 'dotnet format SemiPlot.slnx' and stage again" >&2
exit 1
