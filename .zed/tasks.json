[
  {
    "label": "Build UI",
    "command": "dotnet",
    "args": ["build", "SemiPlot/SemiPlot.UI/SemiPlot.UI.csproj"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "Build Solution",
    "command": "dotnet",
    "args": ["build", "SemiPlot/SemiPlot.slnx"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Run UI",
    "command": "dotnet",
    "args": ["run", "--project", "SemiPlot/SemiPlot.UI/SemiPlot.UI.csproj"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true,
  },
  {
    "label": "Test All",
    "command": "dotnet",
    "args": ["test", "SemiPlot/SemiPlot.Tests/SemiPlot.Tests.csproj"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Test Current File",
    "command": "dotnet",
    "args": [
      "test",
      "SemiPlot/SemiPlot.Tests/SemiPlot.Tests.csproj",
      "--filter",
      "FullyQualifiedName~$ZED_STEM",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "format",
    "command": "dotnet",
    "args": ["format", "SemiPlot/SemiPlot.slnx"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
]
