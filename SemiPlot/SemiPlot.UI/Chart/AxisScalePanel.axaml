<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:chart="clr-namespace:SemiPlot.UI.Chart"
             xmlns:text="clr-namespace:SemiPlot.UI.Localization"
             mc:Ignorable="d"
             d:DesignWidth="360"
             x:Class="SemiPlot.UI.Chart.AxisScalePanel"
             x:DataType="chart:AxisScalePanelViewModel"
             Width="360">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape"
                    Command="{Binding CancelCommand}" />
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
          RowSpacing="10">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">

            <TextBlock Grid.Column="0"
                       Name="AxisScalePenName"
                       Text="{Binding PenName}"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Column="1"
                       Name="AxisScalePenUnit"
                       Text="{Binding PenUnit}"
                       Foreground="{DynamicResource AppSecondaryForegroundBrush}" />

        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="14"
              RowSpacing="10">

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.AxisScaleMaximumLabel}" />

            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Name="AxisScaleMaximum"
                     HorizontalAlignment="Stretch"
                     Classes.invalid="{Binding !IsMaximumValid}"
                     Text="{Binding MaximumText}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter"
                                Command="{Binding ApplyCommand}" />
                </TextBox.KeyBindings>
            </TextBox>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.AxisScaleMinimumLabel}" />

            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Name="AxisScaleMinimum"
                     HorizontalAlignment="Stretch"
                     Classes.invalid="{Binding !IsMinimumValid}"
                     Text="{Binding MinimumText}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter"
                                Command="{Binding ApplyCommand}" />
                </TextBox.KeyBindings>
            </TextBox>

        </Grid>

        <TextBlock Grid.Row="2"
                   Name="AxisScaleValidationMessage"
                   Classes="form-message error"
                   Text="{Binding ValidationMessage}" />

        <Grid Grid.Row="3"
              ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="8"
              RowSpacing="8">

            <Button Grid.Row="0"
                    Grid.Column="0"
                    Name="AxisScaleAutoscaleButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{x:Static text:Resources.MenuViewAutoscale}"
                    Command="{Binding AutoscaleCommand}" />

            <Button Grid.Row="0"
                    Grid.Column="1"
                    Name="AxisScaleInitialScaleButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{x:Static text:Resources.AxisScaleInitialScale}"
                    Command="{Binding InitialScaleCommand}" />

            <Button Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Name="AxisScaleApplyButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{x:Static text:Resources.AxisScaleApply}"
                    Command="{Binding ApplyCommand}" />

        </Grid>

    </Grid>

</UserControl>
