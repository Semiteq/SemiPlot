<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:scottplot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:chart="clr-namespace:SemiPlot.UI.Chart"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="600"
             x:Class="SemiPlot.UI.Chart.TrendChartView"
             x:DataType="chart:TrendChartViewModel">

    <Panel>
        <scottplot:AvaPlot Name="PlotControl" />
        <Canvas Name="CursorOverlay" IsHitTestVisible="False">
            <Line Name="CrosshairLine"
                  IsVisible="False"
                  Stroke="#808080"
                  StrokeThickness="1" />
            <Border Name="ReadoutBox"
                    IsVisible="False"
                    Background="#D9FFFFFF"
                    BorderBrush="#80000000"
                    BorderThickness="1"
                    Padding="4">
                <TextBlock Name="ReadoutText"
                           FontSize="12" />
            </Border>
        </Canvas>
        <TextBox Name="AxisBoundEditor"
                 Width="90"
                 IsVisible="False"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top" />
    </Panel>

</UserControl>
