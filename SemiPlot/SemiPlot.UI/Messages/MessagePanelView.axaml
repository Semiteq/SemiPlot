<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:messages="clr-namespace:SemiPlot.UI.Messages"
             xmlns:text="clr-namespace:SemiPlot.UI.Localization"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="160"
             x:Class="SemiPlot.UI.Messages.MessagePanelView"
             x:DataType="messages:MessagePanelViewModel">

    <UserControl.Styles>
        <Style Selector="Ellipse.severity-error">
            <Setter Property="Fill" Value="{DynamicResource AppSeverityErrorBrush}" />
        </Style>
        <Style Selector="Ellipse.severity-warning">
            <Setter Property="Fill" Value="{DynamicResource AppSeverityWarningBrush}" />
        </Style>
        <Style Selector="Ellipse.severity-info">
            <Setter Property="Fill" Value="{DynamicResource AppSeverityInfoBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel LastChildFill="True">

        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,4">

            <TextBlock Grid.Column="0"
                       Text="{x:Static text:Resources.MessagePanelTitle}"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Name="ClearMessages"
                    Content="{x:Static text:Resources.MessagePanelClear}"
                    Command="{Binding ClearCommand}"
                    Padding="8,2" />

        </Grid>

        <TextBlock DockPanel.Dock="Top"
                   Name="MessagePanelEmpty"
                   Text="{x:Static text:Resources.MessagePanelEmpty}"
                   Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                   IsVisible="{Binding !HasEntries}" />

        <ScrollViewer MaxHeight="140"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="MessageEntries"
                          ItemsSource="{Binding Entries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="messages:MessageEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                              Margin="0,2">

                            <Ellipse Grid.Column="0"
                                     Width="8"
                                     Height="8"
                                     Margin="0,5,8,0"
                                     VerticalAlignment="Top"
                                     Classes.severity-error="{Binding View.Severity, Converter={x:Static messages:SeverityMatchConverter.Instance}, ConverterParameter=Error}"
                                     Classes.severity-warning="{Binding View.Severity, Converter={x:Static messages:SeverityMatchConverter.Instance}, ConverterParameter=Warning}"
                                     Classes.severity-info="{Binding View.Severity, Converter={x:Static messages:SeverityMatchConverter.Instance}, ConverterParameter=Info}" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding View.Title}"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding View.Detail}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding View.Remedy}"
                                           Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding RepeatCount, StringFormat={x:Static text:Resources.MessagePanelRepeatFormat}}"
                                       IsVisible="{Binding HasRepeated}"
                                       Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Top" />

                            <TextBlock Grid.Column="3"
                                       Text="{Binding LastSeen, StringFormat={}{0:HH:mm:ss}}"
                                       Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Top" />

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
