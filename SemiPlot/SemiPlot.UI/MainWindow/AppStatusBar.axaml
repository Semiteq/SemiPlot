<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SemiPlot.UI.MainWindow"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="28"
             x:Class="SemiPlot.UI.MainWindow.AppStatusBar"
             x:DataType="local:AppStatusBarViewModel">

    <UserControl.Styles>
        <Style Selector="Button.connection-ok">
            <Setter Property="Foreground" Value="{DynamicResource AppConnectionOkBrush}" />
        </Style>
        <Style Selector="Button.connection-fault">
            <Setter Property="Foreground" Value="{DynamicResource AppConnectionFaultBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,Auto,Auto"
          HorizontalAlignment="Left">

        <Button Grid.Column="0"
                Name="ConnectionIndicator"
                Classes.connection-ok="{Binding IsConnected}"
                Classes.connection-fault="{Binding !IsConnected}"
                Content="{Binding ConnectionText}"
                Command="{Binding ToggleMessagePanelCommand}"
                Padding="8,2" />

        <Border Grid.Column="1"
                Width="1"
                Margin="8,3"
                Background="{DynamicResource AppSubtleLineBrush}" />

        <TextBlock Grid.Column="2"
                   Name="ActiveLayerText"
                   Text="{Binding LayerText}"
                   VerticalAlignment="Center" />

    </Grid>

</UserControl>
