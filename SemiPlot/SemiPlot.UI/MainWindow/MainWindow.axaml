<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SemiPlot.UI.MainWindow"
        xmlns:chart="clr-namespace:SemiPlot.UI.Chart"
        xmlns:toolbar="clr-namespace:SemiPlot.UI.Toolbar"
        xmlns:legend="clr-namespace:SemiPlot.UI.Legend"
        xmlns:minimap="clr-namespace:SemiPlot.UI.Minimap"
        xmlns:text="clr-namespace:SemiPlot.UI.Localization"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="800"
        x:Class="SemiPlot.UI.MainWindow.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{x:Static text:Resources.WindowTitle}"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">

        <Border Grid.Row="0"
                Name="Toolbar"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="8,4">
            <toolbar:TrendToolbarView DataContext="{Binding ToolbarViewModel}" />
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto">

            <Border Grid.Column="0"
                    Name="ChartContent"
                    Background="{DynamicResource AppContentBackgroundBrush}">
                <chart:TrendChartView DataContext="{Binding ChartViewModel}" />
            </Border>

            <Border Grid.Column="1"
                    Name="LegendPanel"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    Width="280"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Padding="4">
                <legend:TrendLegendView DataContext="{Binding LegendViewModel}" />
            </Border>

        </Grid>

        <minimap:MinimapView Grid.Row="2"
                             Name="Minimap"
                             Height="36"
                             DataContext="{Binding MinimapViewModel}" />

        <Border Grid.Row="3"
                Name="MessagePanel"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="8,4"
                IsVisible="{Binding IsCatalogueEmpty}">
            <TextBlock Text="{x:Static text:Resources.EmptyCatalogueMessage}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Border>

        <Border Grid.Row="4"
                Name="ArchiveConnectionPanel"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="8,4"
                IsVisible="{Binding HasArchiveConnectionMessage}">
            <TextBlock Name="ArchiveConnectionMessage"
                       Text="{Binding ArchiveConnectionMessage}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Border>

        <Border Grid.Row="5"
                Name="StatusBar"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="8,4"
                IsVisible="{Binding !HasStartupFailure}">
            <TextBlock Text="{Binding PenCount, StringFormat={x:Static text:Resources.StatusPenCountFormat}}"
                       VerticalAlignment="Center" />
        </Border>

        <Border Grid.Row="6"
                Name="StartupFailurePanel"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="8,4"
                IsVisible="{Binding HasStartupFailure}">
            <StackPanel>
                <TextBlock Name="StartupFailureTitle"
                           Text="{Binding StartupFailure.Title}"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />
                <TextBlock Name="StartupFailureDetail"
                           Text="{Binding StartupFailure.Detail}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
                <TextBlock Name="StartupFailureRemedy"
                           Text="{Binding StartupFailure.Remedy}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

    </Grid>

</Window>
