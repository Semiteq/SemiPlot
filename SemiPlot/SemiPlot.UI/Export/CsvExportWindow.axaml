<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SemiPlot.UI.Export"
        xmlns:navigation="clr-namespace:SemiPlot.UI.Navigation"
        xmlns:text="clr-namespace:SemiPlot.UI.Localization"
        mc:Ignorable="d"
        d:DesignHeight="420"
        x:Class="SemiPlot.UI.Export.CsvExportWindow"
        x:DataType="local:CsvExportViewModel"
        Title="{x:Static text:Resources.ExportWindowTitle}"
        Width="390"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="ListBox#ExportPens ListBoxItem">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox">
            <Setter Property="navigation:TimeFieldInput.Layout" Value="Date" />
        </Style>
    </Window.Styles>

    <Grid Margin="20"
          RowDefinitions="Auto,Auto,Auto"
          RowSpacing="12">

        <Grid Grid.Row="0"
              IsEnabled="{Binding ExportCommand.IsExecuting^, Converter={x:Static BoolConverters.Not}}"
              ColumnDefinitions="Auto,Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="14"
              RowSpacing="10">

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.ExportStartLabel}" />

            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Name="ExportStartTime"
                     navigation:TimeFieldInput.Layout="ClockTime"
                     Width="110"
                     Classes.invalid="{Binding Form.IsStartTimeInvalid}"
                     Text="{Binding Form.StartTimeText}" />

            <CalendarDatePicker Grid.Row="0"
                                Grid.Column="2"
                                Name="ExportStartDate"
                                HorizontalAlignment="Stretch"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="{x:Static text:Resources.ExportDateFormat}"
                                Classes.invalid="{Binding Form.IsStartDateInvalid}"
                                SelectedDate="{Binding Form.StartDate}" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.ExportEndLabel}" />

            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Name="ExportEndTime"
                     navigation:TimeFieldInput.Layout="ClockTime"
                     Width="110"
                     Classes.invalid="{Binding Form.IsEndTimeInvalid}"
                     Text="{Binding Form.EndTimeText}" />

            <CalendarDatePicker Grid.Row="1"
                                Grid.Column="2"
                                Name="ExportEndDate"
                                HorizontalAlignment="Stretch"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="{x:Static text:Resources.ExportDateFormat}"
                                Classes.invalid="{Binding Form.IsEndDateInvalid}"
                                SelectedDate="{Binding Form.EndDate}" />

            <TextBlock Grid.Row="2"
                       Grid.ColumnSpan="3"
                       Name="ExportPensHeader"
                       Margin="0,10,0,0"
                       FontWeight="Bold">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{x:Static text:Resources.ExportPensHeader}">
                        <Binding Path="Form.TickedPenCount" />
                        <Binding Path="Pens.Count" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <ListBox Grid.Row="3"
                     Grid.ColumnSpan="3"
                     Name="ExportPens"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     MaxHeight="226"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.AllowAutoHide="False"
                     ItemsSource="{Binding Pens}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ExportPenChoice">
                        <CheckBox Height="28"
                                  IsChecked="{Binding IsTicked}"
                                  ToolTip.Tip="{Binding Label}">
                            <TextBlock Text="{Binding Label}"
                                       TextTrimming="CharacterEllipsis" />
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="4"
                       Grid.ColumnSpan="3"
                       Name="ExportCount"
                       Height="20"
                       Text="{Binding CountText}" />

        </Grid>

        <TextBlock Name="ExportMessage"
                   Grid.Row="1"
                   Classes="form-message"
                   Classes.error="{Binding IsMessageError}"
                   ToolTip.Tip="{Binding MessageToolTip}"
                   Text="{Binding Message}" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">

            <Button Name="ExportSaveAs"
                    Content="{x:Static text:Resources.ExportSaveAs}"
                    Click="OnSaveAsClick"
                    IsEnabled="{Binding ExportCommand.CanExecute^}"
                    Padding="12,2" />

            <Button Name="ExportCancel"
                    Content="{x:Static text:Resources.ExportCancel}"
                    Command="{Binding CancelCommand}"
                    Padding="12,2" />

            <Button Name="ExportClose"
                    Content="{x:Static text:Resources.ExportClose}"
                    Click="OnCloseClick"
                    Padding="12,2" />

        </StackPanel>

    </Grid>

</Window>
