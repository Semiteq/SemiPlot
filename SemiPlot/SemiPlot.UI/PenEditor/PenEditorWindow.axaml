<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SemiPlot.UI.PenEditor"
        xmlns:input="clr-namespace:SemiPlot.UI.Input"
        xmlns:legend="clr-namespace:SemiPlot.UI.Legend"
        xmlns:tables="clr-namespace:SemiPlot.UI.Tables"
        xmlns:text="clr-namespace:SemiPlot.UI.Localization"
        xmlns:trends="clr-namespace:SemiPlot.Core.Trends;assembly=SemiPlot.Core"
        x:Class="SemiPlot.UI.PenEditor.PenEditorWindow"
        x:DataType="local:PenEditorViewModel"
        Title="{x:Static text:Resources.PenEditorTitle}"
        Width="1272"
        MinWidth="1260"
        Height="720"
        SizeToContent="Manual"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <GridLength x:Key="IdColumnWidth">72</GridLength>
        <x:Double x:Key="DataGridCellMinHeight">28</x:Double>
        <ColumnDefinitions x:Key="MembershipColumns"
                           x:Shared="False">
            <ColumnDefinition Width="{StaticResource IdColumnWidth}" />
            <ColumnDefinition Width="*" />
        </ColumnDefinitions>
        <ColumnDefinitions x:Key="PenFormColumns"
                           x:Shared="False">
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="240" />
        </ColumnDefinitions>
        <DataTemplate x:Key="LineStyleItem"
                      x:DataType="trends:PenLineStyle">
            <TextBlock Text="{Binding Converter={x:Static local:PenLineStyleConverters.ToLabel}}" />
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="DataGrid#PenList DataGridColumnHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="DataGrid#PenList DataGridCell:current /template/ Rectangle#CurrencyVisual, DataGrid#PenList DataGridCell:focus /template/ Panel#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TextBlock.grid-cell">
            <Setter Property="Margin" Value="12,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.form-label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.form-title">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.form-section">
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ColorPicker#FormColorPicker /template/ DropDownButton /template/ :is(Control)#DropDownGlyph">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Panel#PenForm TextBox.invalid">
            <Setter Property="InnerRightContent">
                <Template>
                    <PathIcon Width="16"
                              Height="16"
                              Margin="0,0,8,0"
                              Data="{StaticResource WarningGeometry}"
                              Foreground="{DynamicResource AppSeverityErrorBrush}" />
                </Template>
            </Setter>
        </Style>
        <Style Selector="ListBox#GroupList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Styles>

    <Grid Margin="12"
          RowDefinitions="*,Auto"
          RowSpacing="12">

        <TabControl Grid.Row="0"
                    Name="PenEditorTabs">

            <TabItem Name="PensTab"
                     Header="{x:Static text:Resources.PenEditorPensTab}">

                <Grid ColumnDefinitions="*,16,420">

                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4">

                        <DataGrid Name="PenList"
                                  ItemsSource="{Binding PenRows}"
                                  SelectedItem="{Binding SelectedRow, Mode=OneWay}"
                                  SelectionChanged="OnPenListSelectionChanged"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserReorderColumns="False"
                                  RowHeight="{x:Static local:PenEditorWindow.RowHeight}"
                                  tables:HeaderMeasuredColumns.IsEnabled="True">
                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="{x:Static text:Resources.PenEditorColumnId}"
                                                        Width="84"
                                                        CanUserSort="True"
                                                        CanUserResize="True"
                                                        CustomSortComparer="{x:Static local:PenRowOrder.ById}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="local:PenRowViewModel">
                                            <TextBlock Name="RowId"
                                                       Classes="grid-cell"
                                                       Text="{Binding Pen.Id}"
                                                       ToolTip.Tip="{Binding $self.Text}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{x:Static text:Resources.PenEditorColumnName}"
                                                        Width="220"
                                                        CanUserSort="True"
                                                        CanUserResize="True"
                                                        CustomSortComparer="{x:Static local:PenRowOrder.ByName}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="local:PenRowViewModel">
                                            <Grid Margin="12,0,8,0"
                                                  ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="8">

                                                <Border Grid.Column="0"
                                                        Name="RowColor"
                                                        Width="12"
                                                        Height="12"
                                                        CornerRadius="6"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="1">
                                                    <Border.Background>
                                                        <Binding Path="Pen.Color"
                                                                 Converter="{x:Static legend:LegendConverters.HexToBrush}" />
                                                    </Border.Background>
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Name="RowName"
                                                           Classes="grid-cell"
                                                           Margin="0"
                                                           Text="{Binding Pen.Name}"
                                                           ToolTip.Tip="{Binding $self.Text}" />

                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{x:Static text:Resources.PenEditorColumnUnit}"
                                                        Width="96"
                                                        CanUserSort="True"
                                                        CanUserResize="True"
                                                        CustomSortComparer="{x:Static local:PenRowOrder.ByUnit}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="local:PenRowViewModel">
                                            <TextBlock Name="RowUnit"
                                                       Classes="grid-cell"
                                                       Text="{Binding Pen.Unit}"
                                                       ToolTip.Tip="{Binding $self.Text}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{x:Static text:Resources.PenEditorColumnOnStart}"
                                                        Width="120"
                                                        CanUserSort="True"
                                                        CanUserResize="True"
                                                        CustomSortComparer="{x:Static local:PenRowOrder.ByEnabledOnStart}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="local:PenRowViewModel">
                                            <PathIcon Name="RowEnabledOnStart"
                                                      Width="12"
                                                      Height="12"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="{StaticResource CheckGeometry}"
                                                      IsVisible="{Binding Pen.EnabledOnStart}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{x:Static text:Resources.PenEditorColumnGroups}"
                                                        Width="96"
                                                        CanUserSort="True"
                                                        CanUserResize="True"
                                                        CustomSortComparer="{x:Static local:PenRowOrder.ByGroups}"
                                                        tables:HeaderMeasuredColumns.IsFill="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="local:PenRowViewModel">
                                            <TextBlock Name="RowGroups"
                                                       Classes="grid-cell"
                                                       Margin="12,0,12,0"
                                                       Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                                       Text="{Binding GroupsText}"
                                                       ToolTip.Tip="{Binding $self.Text}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                    </Border>

                    <Border Grid.Column="2"
                            Name="PenFormPanel"
                            Width="420"
                            Padding="16"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            IsEnabled="{Binding !IsRefreshing}">

                        <Panel>

                            <TextBlock Name="PenFormEmptyHint"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                       Text="{x:Static text:Resources.PenFormEmptyHint}"
                                       IsVisible="{Binding SelectedForm, Converter={x:Static ObjectConverters.IsNull}}" />

                            <ScrollViewer Name="PenFormScroller"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding SelectedForm, Converter={x:Static ObjectConverters.IsNotNull}}">

                                <Panel Name="PenForm"
                                       DataContext="{Binding SelectedForm}">

                                    <StackPanel x:DataType="local:PenFormViewModel">

                                        <Grid Height="24"
                                              ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8">

                                            <TextBlock Grid.Column="0"
                                                       Name="PenFormTitleId"
                                                       Classes="form-title"
                                                       Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                                       Text="{Binding Row.Pen.Id}" />

                                            <TextBlock Grid.Column="1"
                                                       Name="PenFormTitleName"
                                                       Classes="form-title"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Row.Pen.Name}"
                                                       ToolTip.Tip="{Binding $self.Text}" />

                                        </Grid>

                                        <TextBlock Classes="form-section"
                                                   Text="{x:Static text:Resources.PenFormSectionLabel}" />

                                        <Grid HorizontalAlignment="Left"
                                              ColumnDefinitions="{StaticResource PenFormColumns}"
                                              RowDefinitions="32,32,32,32"
                                              ColumnSpacing="12"
                                              RowSpacing="8">

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Classes="form-label"
                                                       Text="{x:Static text:Resources.PenEditorColumnName}" />

                                            <TextBox Grid.Row="0"
                                                     Grid.Column="1"
                                                     Name="FormName"
                                                     Width="240"
                                                     HorizontalAlignment="Left"
                                                     local:PenEditorWindow.Field="Name"
                                                     Classes.invalid="{Binding !IsNameValid}"
                                                     Text="{Binding Name}" />

                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="0"
                                                       Classes="form-label"
                                                       Text="{x:Static text:Resources.PenEditorColumnUnit}" />

                                            <TextBox Grid.Row="1"
                                                     Grid.Column="1"
                                                     Name="FormUnit"
                                                     Width="120"
                                                     HorizontalAlignment="Left"
                                                     local:PenEditorWindow.Field="Unit"
                                                     Classes.invalid="{Binding !IsUnitValid}"
                                                     Text="{Binding Unit}" />

                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="0"
                                                       Classes="form-label"
                                                       Text="{x:Static text:Resources.PenFormMaskLabel}" />

                                            <TextBox Grid.Row="2"
                                                     Grid.Column="1"
                                                     Name="FormMask"
                                                     Width="120"
                                                     HorizontalAlignment="Left"
                                                     local:PenEditorWindow.Field="Mask"
                                                     Classes.invalid="{Binding !IsMaskValid}"
                                                     Text="{Binding Mask}" />

                                            <TextBlock Grid.Row="3"
                                                       Grid.Column="0"
                                                       Classes="form-label"
                                                       Text="{x:Static text:Resources.PenFormMaskPreviewLabel}" />

                                            <TextBlock Grid.Row="3"
                                                       Grid.Column="1"
                                                       Name="FormMaskPreview"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                                       Text="{Binding MaskPreview}"
                                                       ToolTip.Tip="{Binding $self.Text}" />

                                        </Grid>

                                        <TextBlock Classes="form-section"
                                                   Text="{x:Static text:Resources.PenFormSectionAppearance}" />

                                        <Grid HorizontalAlignment="Left"
                                              ColumnDefinitions="{StaticResource PenFormColumns}"
                                              RowDefinitions="32,32"
                                              ColumnSpacing="12"
                                              RowSpacing="8">

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Classes="form-label"
                                                       Text="{x:Static text:Resources.PenFormColorLabel}" />

                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="8">

                                                <TextBox Name="FormColor"
                                                         Width="120"
                                                         local:PenEditorWindow.Field="Color"
                                                         input:FormattedFieldInput.Layout="HexColor"
                                                         PlaceholderText="{x:Static local:PenColorConverters.FieldFormat}"
                                                         Classes.invalid="{Binding !IsColorValid}"
                                                         Text="{Binding Color}" />

                                                <ColorPicker Name="FormColorPicker"
                                                             Width="32"
                                                             Height="32"
                                                             Padding="0"
                                                             IsAlphaEnabled="False"
                                                             IsAlphaVisible="False">
                                                    <ColorPicker.Color>
                                                        <Binding Path="Color"
                                                                 Mode="OneWay"
                                                                 Converter="{x:Static local:PenColorConverters.ToColor}" />
                                                    </ColorPicker.Color>
                                                </ColorPicker>

                                            </StackPanel>

                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="0"
                                                       Classes="form-label"
                                                       Text="{x:Static text:Resources.PenFormLineStyleLabel}" />

                                            <ComboBox Grid.Row="1"
                                                      Grid.Column="1"
                                                      Name="FormLineStyle"
                                                      Width="240"
                                                      HorizontalAlignment="Left"
                                                      ItemsSource="{x:Static local:PenEditorWindow.LineStyles}"
                                                      SelectedItem="{Binding LineStyle, Mode=OneWay}"
                                                      ItemTemplate="{StaticResource LineStyleItem}"
                                                      SelectionChanged="OnLineStyleSelectionChanged" />

                                        </Grid>

                                        <TextBlock Classes="form-section"
                                                   Text="{x:Static text:Resources.PenFormSectionOnStart}" />

                                        <Grid HorizontalAlignment="Left"
                                              ColumnDefinitions="{StaticResource PenFormColumns}"
                                              RowDefinitions="32,Auto,32"
                                              ColumnSpacing="12"
                                              RowSpacing="8">

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Classes="form-label"
                                                       Text="{x:Static text:Resources.PenFormVisibilityLabel}" />

                                            <CheckBox Grid.Row="0"
                                                      Grid.Column="1"
                                                      Name="FormEnabledOnStart"
                                                      HorizontalAlignment="Left"
                                                      Content="{x:Static text:Resources.PenFormShowOnChart}"
                                                      IsChecked="{Binding EnabledOnStart, Mode=OneWay}"
                                                      IsCheckedChanged="OnStartFlagChanged" />

                                            <Grid Grid.Row="1"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Name="FormScale"
                                                  HorizontalAlignment="Left"
                                                  ColumnDefinitions="{StaticResource PenFormColumns}"
                                                  RowDefinitions="32,32"
                                                  ColumnSpacing="12"
                                                  RowSpacing="8">

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           Classes="form-label"
                                                           Text="{x:Static text:Resources.AxisScaleMinimumLabel}" />

                                                <TextBox Grid.Row="0"
                                                         Grid.Column="1"
                                                         Name="FormScaleMinOnStart"
                                                         Width="120"
                                                         HorizontalAlignment="Left"
                                                         Classes.invalid="{Binding !IsScaleMinOnStartValid}"
                                                         Text="{Binding ScaleMinOnStart}" />

                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="0"
                                                           Classes="form-label"
                                                           Text="{x:Static text:Resources.AxisScaleMaximumLabel}" />

                                                <TextBox Grid.Row="1"
                                                         Grid.Column="1"
                                                         Name="FormScaleMaxOnStart"
                                                         Width="120"
                                                         HorizontalAlignment="Left"
                                                         Classes.invalid="{Binding !IsScaleMaxOnStartValid}"
                                                         Text="{Binding ScaleMaxOnStart}" />

                                            </Grid>

                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="0"
                                                       Classes="form-label"
                                                       Text="{x:Static text:Resources.PenFormScaleTypeLabel}" />

                                            <CheckBox Grid.Row="2"
                                                      Grid.Column="1"
                                                      Name="FormLogScaleOnStart"
                                                      HorizontalAlignment="Left"
                                                      Content="{x:Static text:Resources.PenFormLogarithmic}"
                                                      IsChecked="{Binding LogScaleOnStart, Mode=OneWay}"
                                                      IsCheckedChanged="OnStartFlagChanged" />

                                        </Grid>

                                        <TextBlock Name="FormMessage"
                                                   Margin="0,16,0,0"
                                                   Classes="form-message error"
                                                   Text="{Binding Message}" />

                                    </StackPanel>

                                </Panel>

                            </ScrollViewer>

                        </Panel>

                    </Border>

                </Grid>

            </TabItem>

            <TabItem Name="GroupsTab"
                     Header="{x:Static text:Resources.PenEditorGroupsTab}">

                <Panel IsEnabled="{Binding !IsRefreshing}">

                    <Panel Name="GroupsTabContent"
                           DataContext="{Binding Groups}">

                        <Grid x:DataType="local:PenGroupsViewModel"
                              RowDefinitions="*,Auto,Auto"
                              RowSpacing="8">

                            <Grid Grid.Row="0"
                                  ColumnDefinitions="320,*"
                                  ColumnSpacing="12">

                                <Grid Grid.Column="0"
                                      RowDefinitions="Auto,*,Auto,Auto"
                                      RowSpacing="8">

                                    <Grid Grid.Row="0"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">

                                        <TextBox Grid.Column="0"
                                                 Name="NewGroupName"
                                                 PlaceholderText="{x:Static text:Resources.PenGroupsNewNamePlaceholder}"
                                                 Text="{Binding NewGroupName}" />

                                        <Button Grid.Column="1"
                                                Name="CreateGroupButton"
                                                Content="{x:Static text:Resources.PenGroupsCreate}"
                                                Command="{Binding CreateGroupCommand}" />

                                    </Grid>

                                    <ListBox Grid.Row="1"
                                             Name="GroupList"
                                             ItemsSource="{Binding Groups}"
                                             SelectedItem="{Binding SelectedGroup}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:PenGroupViewModel">
                                                <Grid Height="{x:Static local:PenEditorWindow.RowHeight}"
                                                      ColumnDefinitions="*,Auto">

                                                    <TextBlock Grid.Column="0"
                                                               Name="GroupName"
                                                               Classes="cell"
                                                               Text="{Binding Group.Name}" />

                                                    <TextBlock Grid.Column="1"
                                                               Name="GroupMemberCount"
                                                               Classes="cell"
                                                               Text="{Binding MemberCount}" />

                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Grid.Row="2"
                                               Classes="form-label"
                                               Text="{x:Static text:Resources.PenGroupsNameLabel}" />

                                    <Grid Grid.Row="3"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">

                                        <Panel Grid.Column="0">
                                            <Panel.IsEnabled>
                                                <Binding Path="SelectedGroup"
                                                         Converter="{x:Static ObjectConverters.IsNotNull}" />
                                            </Panel.IsEnabled>

                                            <StackPanel DataContext="{Binding SelectedGroup}"
                                                        Spacing="8">

                                                <TextBox x:DataType="local:PenGroupViewModel"
                                                         Name="GroupRename"
                                                         Classes.invalid="{Binding !IsNameValid}"
                                                         Text="{Binding RenameDraft}" />

                                                <CheckBox x:DataType="local:PenGroupViewModel"
                                                          Name="GroupFoldedOnStartBox"
                                                          Content="{x:Static text:Resources.PenGroupsFoldedOnStartLabel}"
                                                          IsChecked="{Binding FoldedOnStart, Mode=OneWay}"
                                                          Command="{Binding ToggleFoldedOnStartCommand}" />

                                            </StackPanel>

                                        </Panel>

                                        <Button Grid.Column="1"
                                                Name="DeleteGroupButton"
                                                VerticalAlignment="Top"
                                                Content="{x:Static text:Resources.PenGroupsDelete}"
                                                Command="{Binding DeleteGroupCommand}" />

                                    </Grid>

                                </Grid>

                                <Grid Grid.Column="1"
                                      RowDefinitions="Auto,*"
                                      RowSpacing="8">

                                    <TextBlock Grid.Row="0"
                                               Classes="form-label"
                                               Text="{x:Static text:Resources.PenGroupsMembersHeader}" />

                                    <ScrollViewer Grid.Row="1"
                                                  Name="MembershipScroller">
                                        <ItemsControl Name="MembershipList"
                                                      ItemsSource="{Binding Memberships}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:PenMembershipViewModel">
                                                    <CheckBox Name="MembershipBox"
                                                              Height="{x:Static local:PenEditorWindow.RowHeight}"
                                                              IsChecked="{Binding IsMember, Mode=OneWay}"
                                                              Command="{Binding ToggleMembershipCommand}">
                                                        <Grid ColumnDefinitions="{StaticResource MembershipColumns}">

                                                            <TextBlock Grid.Column="0"
                                                                       Classes="cell"
                                                                       Text="{Binding Row.Pen.Id}" />

                                                            <TextBlock Grid.Column="1"
                                                                       Name="MembershipName"
                                                                       Classes="cell"
                                                                       Text="{Binding Row.Pen.Name}" />

                                                        </Grid>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                </Grid>

                            </Grid>

                            <Grid Grid.Row="1"
                                  Name="GroupDeletionRow"
                                  Height="32"
                                  ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="8">

                                <TextBlock Grid.Column="0"
                                           Name="GroupDeletionText"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding PendingDeletion.Text}" />

                                <Button Grid.Column="1"
                                        Name="ConfirmDeleteButton"
                                        Content="{x:Static text:Resources.PenGroupsDelete}"
                                        Command="{Binding ConfirmDeleteCommand}">
                                    <Button.IsVisible>
                                        <Binding Path="PendingDeletion"
                                                 Converter="{x:Static ObjectConverters.IsNotNull}" />
                                    </Button.IsVisible>
                                </Button>

                                <Button Grid.Column="2"
                                        Name="CancelDeleteButton"
                                        Content="{x:Static text:Resources.PenGroupsCancel}"
                                        Command="{Binding CancelDeleteCommand}">
                                    <Button.IsVisible>
                                        <Binding Path="PendingDeletion"
                                                 Converter="{x:Static ObjectConverters.IsNotNull}" />
                                    </Button.IsVisible>
                                </Button>

                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Name="GroupsMessage"
                                       Classes="form-message error"
                                       Text="{Binding Message}" />

                        </Grid>

                    </Panel>

                </Panel>

            </TabItem>

        </TabControl>

        <Grid Grid.Row="1"
              Name="PenEditorBottomBar"
              HorizontalAlignment="Right"
              ColumnDefinitions="Auto,Auto"
              ColumnSpacing="12">

            <TextBlock Grid.Column="0"
                       Name="PenEditorAddedCount"
                       VerticalAlignment="Center"
                       Text="{Binding AddedCountText}" />

            <Button Grid.Column="1"
                    Name="PenEditorRefreshButton"
                    Padding="12,2"
                    Content="{x:Static text:Resources.PenEditorRefresh}"
                    Command="{Binding RefreshCommand}" />

        </Grid>

    </Grid>

</Window>
