<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:minimap="clr-namespace:SemiPlot.UI.Minimap"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="30"
             x:Class="SemiPlot.UI.Minimap.DayCalendarView"
             x:DataType="minimap:MinimapViewModel"
             ClipToBounds="False">

    <Grid RowDefinitions="16,14">
        <minimap:MinimapDayCalendar Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Name="CalendarCells"
                                    IsHitTestVisible="False"
                                    PresenceBrush="{DynamicResource AppMinimapPresenceBrush}"
                                    AccentBrush="{DynamicResource AppAccentBrush}"
                                    HoverBrush="{DynamicResource AppSecondaryForegroundBrush}"
                                    SeparatorBrush="{DynamicResource AppSubtleLineBrush}"
                                    MarkerBrush="{DynamicResource AppMarkerLineBrush}" />
        <Panel Grid.Row="0"
               Name="CalendarCellRow"
               Background="Transparent" />
        <Canvas Grid.Row="1"
                Name="CalendarLabels"
                ClipToBounds="True" />
    </Grid>

</UserControl>
