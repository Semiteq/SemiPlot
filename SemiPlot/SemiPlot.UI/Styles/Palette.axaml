            <SolidColorBrush x:Key="TabItemLineHeaderSelectedForeground" Color="#DFE1E5" />
            <SolidColorBrush x:Key="TabItemLinePipeSelectedBackground" Color="#3574F0" />
            <SolidColorBrush x:Key="TabControlSeparatorBorderBrush" Color="#393B40" />
            <SolidColorBrush x:Key="ListBoxItemPointeroverForeground" Color="#DFE1E5" />
            <SolidColorBrush x:Key="ListBoxItemPressedForeground" Color="#DFE1E5" />
            <SolidColorBrush x:Key="ListBoxItemSelectedForeground" Color="#DFE1E5" />
            <SolidColorBrush x:Key="ListBoxItemSelectedBackground" Color="#3574F0" Opacity="0.25" />
            <SolidColorBrush x:Key="ListBoxItemSelectedPointeroverBackground" Color="#3574F0" Opacity="0.25" />

            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#DFE1E5" />
            <SolidColorBrush x:Key="ComboBoxItemFocusForeground" Color="#DFE1E5" />
            <SolidColorBrush x:Key="ComboBoxItemPointeroverForeground" Color="#DFE1E5" />
            <SolidColorBrush x:Key="ComboBoxItemSelectedForeground" Color="#DFE1E5" />
            <SolidColorBrush x:Key="ComboBoxIconPointeroverForeground" Color="#DFE1E5" />
            <SolidColorBrush x:Key="FlyoutForeground" Color="#DFE1E5" />
            <SolidColorBrush x:Key="ComboBoxDisabledForeground" Color="#5A5D63" />
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBorderBrush" Color="#3574F0" />
            <SolidColorBrush x:Key="ColorViewTabItemSelectedForeground" Color="#3574F0" />
            <SolidColorBrush x:Key="ColorViewRadioButtonForeground" Color="#3574F0" />
            <SolidColorBrush x:Key="ColorViewRadioButtonCheckedBackground" Color="#3574F0" />
            <SolidColorBrush x:Key="ComboBoxItemSelectedBackground" Color="#3574F0" Opacity="0.25" />
            <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#2B2D30" />
            <SolidColorBrush x:Key="FlyoutBackground" Color="#2B2D30" />
            <SolidColorBrush x:Key="ColorViewRadioButtonBackground" Color="#1E1F22" />
            <SolidColorBrush x:Key="ComboBoxPopupBorderBrush" Color="#393B40" />
            <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#393B40" />
            <SolidColorBrush x:Key="ColorSpectrumBorderBrush" Color="#393B40" />
            <SolidColorBrush x:Key="CheckBoxDefaultDisabledBorderBrush" Color="#393B40" />

            <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBackground" Color="#3574F0" />
            <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBorderBrush" Color="#3574F0" />
            <SolidColorBrush x:Key="CheckBoxCheckedPressedBackground" Color="#3574F0" />
            <SolidColorBrush x:Key="CheckBoxCheckedPressedBorderBrush" Color="#3574F0" />
