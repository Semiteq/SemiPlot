<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SemiPlot.UI.Export"
        xmlns:input="clr-namespace:SemiPlot.UI.Input"
        xmlns:text="clr-namespace:SemiPlot.UI.Localization"
        mc:Ignorable="d"
        d:DesignHeight="520"
        x:Class="SemiPlot.UI.Export.CsvExportWindow"
        x:DataType="local:CsvExportViewModel"
        Title="{x:Static text:Resources.ExportWindowTitle}"
        Width="390"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataTemplate x:Key="ExportMarkerChoiceTemplate"
                      x:DataType="local:ExportMarkerChoice">
            <TextBlock Text="{Binding Text}"
                       Classes.no-marker="{Binding IsNoMarker}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="ExportMarkerLabelTemplate"
                      x:DataType="local:ExportMarkerChoice">
            <TextBlock Text="{Binding Label}"
                       Classes.no-marker="{Binding IsNoMarker}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.no-marker">
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryForegroundBrush}" />
        </Style>
    </Window.Styles>

    <Grid Margin="16"
          RowDefinitions="Auto,Auto,Auto"
          RowSpacing="12">

        <Grid Grid.Row="0"
              IsEnabled="{Binding ExportCommand.IsExecuting^, Converter={x:Static BoolConverters.Not}}"
              ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="8">

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.ExportStartLabel}" />

            <CalendarDatePicker Grid.Row="0"
                                Grid.Column="1"
                                Name="ExportStartDate"
                                HorizontalAlignment="Stretch"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="{x:Static text:Resources.ExportDateFormat}"
                                DisplayDateStart="{Binding Days.FirstDay}"
                                DisplayDateEnd="{Binding Days.LastDay}"
                                Classes.invalid="{Binding Form.IsStartDateInvalid}"
                                SelectedDate="{Binding Form.StartDate}" />

            <Grid Grid.Row="1"
                  Grid.Column="1"
                  ColumnDefinitions="110,*"
                  ColumnSpacing="8">

                <TextBox Grid.Column="0"
                         Name="ExportStartTime"
                         input:FormattedFieldInput.Layout="ClockTime"
                         Classes.invalid="{Binding Form.IsStartTimeInvalid}"
                         Text="{Binding Form.StartTimeText}" />

                <ComboBox Grid.Column="1"
                          Name="ExportStartMarker"
                          HorizontalAlignment="Stretch"
                          IsEnabled="{Binding !!StartMarkers.Count}"
                          ItemsSource="{Binding StartChoices}"
                          SelectedItem="{Binding SelectedStartMarker}"
                          ItemTemplate="{StaticResource ExportMarkerChoiceTemplate}"
                          SelectionBoxItemTemplate="{StaticResource ExportMarkerLabelTemplate}" />

            </Grid>

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Margin="0,8,0,0"
                       VerticalAlignment="Center"
                       Text="{x:Static text:Resources.ExportEndLabel}" />

            <CalendarDatePicker Grid.Row="2"
                                Grid.Column="1"
                                Name="ExportEndDate"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="{x:Static text:Resources.ExportDateFormat}"
                                DisplayDateStart="{Binding Days.FirstDay}"
                                DisplayDateEnd="{Binding Days.LastDay}"
                                Classes.invalid="{Binding Form.IsEndDateInvalid}"
                                SelectedDate="{Binding Form.EndDate}" />

            <Grid Grid.Row="3"
                  Grid.Column="1"
                  ColumnDefinitions="110,*"
                  ColumnSpacing="8">

                <TextBox Grid.Column="0"
                         Name="ExportEndTime"
                         input:FormattedFieldInput.Layout="ClockTime"
                         Classes.invalid="{Binding Form.IsEndTimeInvalid}"
                         Text="{Binding Form.EndTimeText}" />

                <ComboBox Grid.Column="1"
                          Name="ExportEndMarker"
                          HorizontalAlignment="Stretch"
                          IsEnabled="{Binding !!EndMarkers.Count}"
                          ItemsSource="{Binding EndChoices}"
                          SelectedItem="{Binding SelectedEndMarker}"
                          ItemTemplate="{StaticResource ExportMarkerChoiceTemplate}"
                          SelectionBoxItemTemplate="{StaticResource ExportMarkerLabelTemplate}" />

            </Grid>

            <TextBlock Grid.Row="4"
                       Grid.ColumnSpan="2"
                       Name="ExportPensHeader"
                       Margin="0,8,0,0"
                       FontWeight="Bold">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{x:Static text:Resources.ExportPensHeader}">
                        <Binding Path="Form.TickedPenCount" />
                        <Binding Path="Pens.Count" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Border Grid.Row="5"
                    Grid.ColumnSpan="2"
                    Name="ExportPens"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    MaxHeight="226">
                <ScrollViewer Name="ExportPensScroller"
                              HorizontalScrollBarVisibility="Disabled"
                              AllowAutoHide="False">
                    <ItemsControl Name="ExportPenItems"
                                  KeyboardNavigation.TabNavigation="Once"
                                  ItemsSource="{Binding Pens}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ExportPenChoice">
                                <CheckBox Height="28"
                                          Margin="8,0"
                                          IsChecked="{Binding IsTicked}"
                                          ToolTip.Tip="{Binding Label}">
                                    <TextBlock Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="6"
                       Grid.ColumnSpan="2"
                       Name="ExportCount"
                       Height="20"
                       Text="{Binding CountText}" />

        </Grid>

        <TextBlock Name="ExportMessage"
                   Grid.Row="1"
                   Classes="form-message"
                   Classes.error="{Binding IsMessageError}"
                   ToolTip.Tip="{Binding MessageToolTip}"
                   Text="{Binding Message}" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">

            <Button Name="ExportSaveAs"
                    Content="{x:Static text:Resources.ExportSaveAs}"
                    Click="OnSaveAsClick"
                    IsEnabled="{Binding ExportCommand.CanExecute^}" />

            <Button Name="ExportCancel"
                    Content="{x:Static text:Resources.ExportCancel}"
                    Command="{Binding CancelCommand}" />

            <Button Name="ExportClose"
                    Content="{x:Static text:Resources.ExportClose}"
                    Click="OnCloseClick" />

        </StackPanel>

    </Grid>

</Window>
