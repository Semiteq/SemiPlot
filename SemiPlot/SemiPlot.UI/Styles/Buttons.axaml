<!-- docs/architecture/ui-theme.md#the-applications-own-surfaces -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Semi paints every state on the presenter; :not(:disabled) leaves Semi's disabled brushes in place -->
    <Style Selector="Button.destructive:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppDestructiveBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppDestructiveForegroundBrush}" />
    </Style>

    <Style Selector="Button.destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppDestructivePointeroverBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppDestructiveForegroundBrush}" />
    </Style>

    <Style Selector="Button.destructive:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppDestructivePressedBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppDestructiveForegroundBrush}" />
    </Style>

    <Style Selector="Button.iconStep">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>

    <Style Selector="Button.iconStep PathIcon">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <!-- A step column beside a track: 24 px wide, as tall as its row, borderless; Tertiary greys its glyph -->
    <Style Selector="Button.iconStep.narrow">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

</Styles>
