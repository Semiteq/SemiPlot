<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:navigation="clr-namespace:SemiPlot.UI.Navigation"
             xmlns:text="clr-namespace:SemiPlot.UI.Localization"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="40"
             x:Class="SemiPlot.UI.Navigation.NavigationBarView"
             x:DataType="navigation:NavigationBarViewModel">

    <UserControl.Styles>
        <Style Selector="Border.groupSeparator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="Background" Value="{DynamicResource AppSubtleLineBrush}" />
        </Style>
        <Style Selector="Button#PreviousRunButton">
            <Setter Property="ToolTip.Tip" Value="{x:Static navigation:WindowGestures.PreviousRunTip}" />
        </Style>
        <Style Selector="Button#PreviousRunButton:disabled">
            <Setter Property="ToolTip.Tip" Value="{x:Static text:Resources.NavigationNoEarlierRunTip}" />
        </Style>
        <Style Selector="Button#NextRunButton">
            <Setter Property="ToolTip.Tip" Value="{x:Static navigation:WindowGestures.NextRunTip}" />
        </Style>
        <Style Selector="Button#NextRunButton:disabled">
            <Setter Property="ToolTip.Tip" Value="{x:Static text:Resources.NavigationNoLaterRunTip}" />
        </Style>
        <Style Selector="Button#LatestRunButton">
            <Setter Property="ToolTip.Tip" Value="{x:Static navigation:WindowGestures.LatestRunTip}" />
        </Style>
        <Style Selector="Button.noRuns:disabled">
            <Setter Property="ToolTip.Tip" Value="{x:Static text:Resources.NavigationNoRecipeRunsTip}" />
        </Style>
        <Style Selector="DropDownButton#RecipeRunsButton">
            <Setter Property="ToolTip.Tip" Value="{x:Static navigation:WindowGestures.RecipeRunListTip}" />
        </Style>
        <Style Selector="DropDownButton#RecipeRunsButton:disabled">
            <Setter Property="ToolTip.Tip" Value="{x:Static text:Resources.NavigationNoRecipeRunsTip}" />
        </Style>
        <Style Selector="DropDownButton#MarkersButton">
            <Setter Property="ToolTip.Tip" Value="{x:Static navigation:WindowGestures.MarkerListTip}" />
        </Style>
        <Style Selector="DropDownButton#MarkersButton:disabled">
            <Setter Property="ToolTip.Tip" Value="{x:Static text:Resources.NavigationNoMarkersTip}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">

        <Button Content="{x:Static text:Resources.NavigationJumpToNow}"
                Command="{Binding JumpToNowCommand}" />

        <ToggleButton Content="{x:Static text:Resources.NavigationSticky}"
                      IsChecked="{Binding IsSticky, Mode=OneWay}"
                      Command="{Binding ToggleStickyCommand}" />

        <Border Classes="groupSeparator" />

        <DropDownButton Name="RecipeRunsButton"
                        ToolTip.ShowOnDisabled="True"
                        IsEnabled="{Binding HasRecipeRunEntries}"
                        Content="{x:Static text:Resources.NavigationRecipeRun}">
            <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                    <navigation:NavigationListView Name="RecipeRunListContent" />
                </Flyout>
            </DropDownButton.Flyout>
        </DropDownButton>

        <Button Name="PreviousRunButton"
                Classes="iconStep"
                Classes.noRuns="{Binding !HasRecipeRuns}"
                Command="{Binding PreviousRunCommand}">
            <PathIcon Data="{StaticResource ChevronLeftGeometry}" />
        </Button>

        <Button Name="NextRunButton"
                Classes="iconStep"
                Classes.noRuns="{Binding !HasRecipeRuns}"
                Command="{Binding NextRunCommand}">
            <PathIcon Data="{StaticResource ChevronRightGeometry}" />
        </Button>

        <Button Name="LatestRunButton"
                Classes.noRuns="{Binding !HasRecipeRuns}"
                ToolTip.ShowOnDisabled="True"
                Content="{x:Static text:Resources.NavigationLatestRun}"
                Command="{Binding LatestRunCommand}" />

        <DropDownButton Name="MarkersButton"
                        ToolTip.ShowOnDisabled="True"
                        IsEnabled="{Binding HasOperatorMarkers}"
                        Content="{x:Static text:Resources.NavigationMarkers}">
            <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                    <navigation:NavigationListView Name="MarkerListContent" />
                </Flyout>
            </DropDownButton.Flyout>
        </DropDownButton>

        <Border Classes="groupSeparator" />

        <ToggleButton Content="{x:Static text:Resources.NavigationDelta}"
                      IsChecked="{Binding IsDeltaModeEnabled, Mode=OneWay}"
                      Command="{Binding ToggleDeltaModeCommand}" />

        <TextBlock Text="{Binding DeltaReadoutText}"
                   IsVisible="{Binding IsDeltaModeEnabled}"
                   VerticalAlignment="Center" />

    </StackPanel>

</UserControl>
