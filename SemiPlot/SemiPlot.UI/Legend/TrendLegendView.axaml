<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:legend="clr-namespace:SemiPlot.UI.Legend"
             mc:Ignorable="d"
             d:DesignWidth="320"
             d:DesignHeight="400"
             x:Class="SemiPlot.UI.Legend.TrendLegendView"
             x:DataType="legend:TrendLegendViewModel">

    <UserControl.Styles>
        <Style Selector="ContentPresenter:nth-child(1) Border#GroupSeparator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid#RowContent">
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <Style Selector="StackPanel.headed Grid#RowContent">
            <Setter Property="Margin" Value="24,2,4,2" />
        </Style>
        <Style Selector="Border#RowRoot">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border#RowRoot.active">
            <Setter Property="Background" Value="{DynamicResource AppAccentFillBrush}" />
        </Style>
        <Style Selector="ToggleButton#GroupFoldToggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton#GroupFoldToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton#GroupFoldToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton#GroupFoldToggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton#GroupFoldToggle PathIcon">
            <Setter Property="Data" Value="{StaticResource ChevronUpGeometry}" />
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryForegroundBrush}" />
        </Style>
        <Style Selector="ToggleButton#GroupFoldToggle:checked PathIcon">
            <Setter Property="Data" Value="{StaticResource ChevronDownGeometry}" />
        </Style>
        <Style Selector="ToggleButton#GroupFoldToggle:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style Selector="Grid#PanelTopRow > Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid#PanelTopRow > Button > Panel > TextBlock">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button#PanelStateToggle PathIcon">
            <Setter Property="Data" Value="{StaticResource ChevronDoubleLeftGeometry}" />
        </Style>
        <Style Selector="Button#PanelStateToggle.expanded PathIcon">
            <Setter Property="Data" Value="{StaticResource ChevronDoubleRightGeometry}" />
        </Style>
        <Style Selector="Button#FoldAllButton PathIcon">
            <Setter Property="Data" Value="{StaticResource ChevronDoubleUpGeometry}" />
        </Style>
        <Style Selector="Button#FoldAllButton.allFolded PathIcon">
            <Setter Property="Data" Value="{StaticResource ChevronDoubleDownGeometry}" />
        </Style>
        <!-- docs/architecture/overview.md#the-sidebar-fold -->
        <ContainerQuery Name="LegendRoot"
                        Query="min-width:263">
            <Style Selector="Grid#PanelTopRow > Button">
                <Setter Property="Width" Value="NaN" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="8,2" />
            </Style>
            <Style Selector="Grid#PanelTopRow > Button > Panel > TextBlock">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="Grid#PanelTopRow > Button > Panel > PathIcon">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <DockPanel Container.Name="LegendRoot"
               Container.Sizing="Width"
               LastChildFill="True">

        <Grid Name="PanelTopRow"
              DockPanel.Dock="Top"
              ColumnDefinitions="Auto,*,Auto"
              Height="28">

            <Button Name="PanelStateToggle"
                    Grid.Column="0"
                    Classes.expanded="{Binding IsExpanded}"
                    ToolTip.Tip="{Binding ToggleTip}"
                    AutomationProperties.Name="{Binding ToggleTip}"
                    Command="{Binding ToggleExpandedCommand}">
                <Panel>
                    <TextBlock Text="{Binding ToggleText}" />
                    <PathIcon Width="12"
                              Height="12" />
                </Panel>
            </Button>

            <Button Name="FoldAllButton"
                    Grid.Column="2"
                    Classes.allFolded="{Binding AreAllFolded}"
                    ToolTip.Tip="{Binding FoldAllGroupsText}"
                    AutomationProperties.Name="{Binding FoldAllGroupsText}"
                    Command="{Binding ToggleAllFoldsCommand}">
                <Panel>
                    <TextBlock Text="{Binding FoldAllText}" />
                    <PathIcon Width="12"
                              Height="12" />
                </Panel>
            </Button>

        </Grid>

        <Border Name="TopRowSeparator"
                DockPanel.Dock="Top"
                Height="1"
                Margin="0,0,0,4"
                Background="{DynamicResource AppSubtleLineBrush}" />

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="legend:TrendLegendGroupViewModel">
                        <StackPanel Classes.headed="{Binding HasHeader}"
                                    Margin="0,0,0,8">

                            <Border Name="GroupSeparator"
                                    Height="1"
                                    Margin="0,0,0,4"
                                    Background="{DynamicResource AppSubtleLineBrush}" />

                            <Grid Name="GroupHeaderRow"
                                  ColumnDefinitions="Auto,*,Auto"
                                  IsVisible="{Binding HasHeader}"
                                  Margin="0,4,16,2">

                                <Border Name="HeaderActiveBar"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource AppAccentBrush}"
                                        IsVisible="{Binding ShowsActiveAccent}" />

                                <CheckBox Name="GroupSwitch"
                                          Grid.Column="0"
                                          IsChecked="{Binding SwitchState, Mode=OneWay}"
                                          Command="{Binding SwitchGroupCommand}"
                                          AutomationProperties.Name="{Binding SwitchName}"
                                          VerticalAlignment="Center"
                                          Margin="4,0,4,0" />

                                <TextBlock Name="GroupHeader"
                                           Grid.Column="1"
                                           Text="{Binding Name, Converter={x:Static legend:LegendConverters.ToCapitals}}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Name}"
                                           VerticalAlignment="Center" />

                                <ToggleButton Name="GroupFoldToggle"
                                              Grid.Column="2"
                                              IsChecked="{Binding IsFolded, Mode=OneWay}"
                                              Command="{Binding FoldCommand}"
                                              ToolTip.Tip="{Binding FoldName}"
                                              AutomationProperties.Name="{Binding FoldName}"
                                              Width="20"
                                              Height="16"
                                              MinHeight="0"
                                              Padding="0"
                                              VerticalAlignment="Center">
                                    <PathIcon Width="10"
                                              Height="10" />
                                </ToggleButton>

                            </Grid>

                            <ItemsControl ItemsSource="{Binding Rows}"
                                          IsVisible="{Binding !IsFolded}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="legend:TrendLegendRowViewModel">
                                        <Border Name="RowRoot"
                                                Classes.active="{Binding IsActive}"
                                                PointerPressed="OnRowPressed">
                                            <Grid>

                                                <Border Name="ActiveBar"
                                                        Width="3"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource AppAccentBrush}"
                                                        IsVisible="{Binding IsActive}" />

                                                <Grid Name="RowContent"
                                                      ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                                      VerticalAlignment="Center">

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding PenState.IsVisible, Mode=OneWay}"
                                                              Command="{Binding ToggleVisibilityCommand}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,4,0" />

                                                    <Border Grid.Column="1"
                                                            Name="RowColor"
                                                            Width="12"
                                                            Height="12"
                                                            CornerRadius="6"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding PenState.Pen.Color, Converter={x:Static legend:LegendConverters.HexToBrush}}" />

                                                    <TextBlock Grid.Column="2"
                                                               Name="RowName"
                                                               Text="{Binding PenState.Pen.Name}"
                                                               VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="3"
                                                               Name="RowValue"
                                                               Text="{Binding CurrentValueText}"
                                                               IsVisible="{Binding $parent[UserControl].DataContext.IsExpanded}"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="4"
                                                               Name="RowUnit"
                                                               Text="{Binding PenState.Pen.Unit}"
                                                               IsVisible="{Binding $parent[UserControl].DataContext.IsExpanded}"
                                                               Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                                               Margin="4,0,0,0"
                                                               VerticalAlignment="Center" />

                                                </Grid>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
